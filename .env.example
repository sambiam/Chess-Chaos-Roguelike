# Copy this file to .env.local for local dev (vercel dev picks it up automatically),
# and set the same values in your Vercel project's Environment Variables for deployment.

# --- Password gate (api/auth.js) ---
# Whatever your friend group agrees on. Checked against the login modal.
CHESS_SECRET=

# --- Upstash Redis (api/_lib/redis.js) ---
# Create a free Redis DB at https://console.upstash.com, or via the Vercel
# Marketplace "Upstash" integration (which sets these automatically).
# The app talks to Upstash over HTTPS, so it needs a REST endpoint + token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Equivalent alternatives, checked in this order if the two above are unset:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  (Upstash console)
#   REDIS_URL (or KV_URL)  — an Upstash connection string of the form
#     rediss://default:<token>@<db>.upstash.io:6379, from which the REST
#     endpoint and token are derived automatically.
# Note: a non-Upstash redis:// server will NOT work — @upstash/redis speaks
# HTTPS, not the Redis wire protocol.
# Prefixed names work too, so a Vercel Marketplace integration namespaced to
# your project (CHESS_KV_REST_API_URL, chess_REDIS_URL, ...) needs no renaming.
# A read-only token is never used — the game writes on every move.

# --- Pusher Channels (api/_lib/pusher.js) ---
# Create a free app at https://dashboard.pusher.com (Channels product).
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# --- Pusher Channels, client-side (src/network.js) ---
# Same PUSHER_KEY / PUSHER_CLUSTER values as above, exposed to the frontend.
# Vite only exposes env vars prefixed with VITE_ to client code.
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=
